# =============================================================================
# Singr Karaoke Connect — Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in the values.
# Run `bash scripts/deploy-setup.sh` for an interactive setup wizard.

# ── DATABASE ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Generate a strong password:
#   openssl rand -base64 24
DATABASE_URL="postgresql://singr:CHANGE_ME@localhost:25432/singr"

# ── REDIS ────────────────────────────────────────────────────────────────────
# Used for rate limiting, session caching, and pub/sub.
REDIS_URL="redis://localhost:26379"

# ── BETTER AUTH ──────────────────────────────────────────────────────────────
# Secret used to sign sessions and tokens. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""

# The canonical base URL for auth callbacks, email links, and OAuth redirects.
# In production this should be the host portal URL (primary auth surface).
BETTER_AUTH_URL="https://host.singrkaraoke.com"

# ── GOOGLE OAUTH ─────────────────────────────────────────────────────────────
# Obtain from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── APPLE SIGN-IN ────────────────────────────────────────────────────────────
# Configure at https://developer.apple.com/account/resources/identifiers
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
# Base64-encoded .p8 private key contents (one line, no headers):
#   base64 -i AuthKey_XXXXX.p8 | tr -d '\n'
APPLE_PRIVATE_KEY=""

# ── TWILIO (SMS / Phone OTP) ────────────────────────────────────────────────
# Required for phone-based sign-in and SMS 2FA.
# Obtain from https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ── SMTP (Email) ────────────────────────────────────────────────────────────
# Used for password reset, email verification, magic links, and email OTP.
# Works with any SMTP provider (Mailjet, SendGrid, SES, Postmark, etc).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@singrkaraoke.com"

# ── STRIPE (Billing & Subscriptions) ────────────────────────────────────────
# Obtain from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Webhook signing secret from Stripe Dashboard → Webhooks
STRIPE_WEBHOOK_SECRET=""

# ── SENTRY (Error Monitoring — per-app DSNs) ────────────────────────────────
# Each app has its own Sentry project for isolated error tracking.
# Auth token is used at build time to upload sourcemaps.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_HOST_PORTAL_DSN=""
SENTRY_ADMIN_CONSOLE_DSN=""
SENTRY_API_DSN=""
SENTRY_SINGER_APP_DSN=""

# ── HERE API (Venue Geolocation) ─────────────────────────────────────────────
# Used for venue address lookup and geocoding.
HERE_API_KEY=""

# ── PORTS ────────────────────────────────────────────────────────────────────
# Configure to avoid conflicts with other services on the same server.
PORT_DB=25432
PORT_REDIS=26379
PORT_MARKETING=25000
PORT_HOST_PORTAL=25001
PORT_ADMIN_CONSOLE=25002
PORT_API=25003
PORT_SINGER_APP=25004

# ── APP CONFIG ───────────────────────────────────────────────────────────────
NODE_ENV="development"
LOG_LEVEL="debug"

# ── RATE LIMITING ────────────────────────────────────────────────────────────
# Applied to the OpenKJ API endpoints via Redis sliding window.
API_RATE_LIMIT_MAX="1000"
API_RATE_LIMIT_WINDOW="3600000"
