{
  "name": "singr-karaoke-connect",
  "version": "2.0.0",
  "private": true,
  "description": "Singr Karaoke Connect \u2014 Turborepo monorepo for the professional karaoke platform.",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules/.cache",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "db:generate": "pnpm --filter @singr/database exec prisma generate",
    "db:push": "pnpm --filter @singr/database exec prisma db push",
    "db:migrate": "pnpm --filter @singr/database exec prisma migrate dev",
    "db:migrate:deploy": "pnpm --filter @singr/database exec prisma migrate deploy",
    "db:seed": "pnpm --filter @singr/database run db:seed",
    "db:studio": "pnpm --filter @singr/database exec prisma studio",
    "postinstall": "pnpm --filter @singr/database exec prisma generate"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "karaoke",
    "singr",
    "openkj",
    "multi-tenant",
    "stripe",
    "nextjs",
    "prisma",
    "monorepo",
    "turborepo"
  ],
  "author": "KirkNetworks, LLC",
  "license": "ISC"
}